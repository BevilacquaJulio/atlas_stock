# URL base da API NestJS (inclua o prefixo /api). Baked no build — nunca coloque segredo aqui.
VITE_API_URL=/api

# Conta demo do botão "Preencher acesso demo" (portfolio). Opcional e PÚBLICA no
# bundle: use só a conta OPERADOR criada pelo populate (DEMO_EMAIL/DEMO_PASSWORD).
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
